# LLM provider
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=

# Core behavior
KARIOS_WAKE_WORD=karios
KARIOS_STT_SAMPLE_RATE=16000
KARIOS_VOSK_MODEL_PATH=models/vosk
KARIOS_PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
KARIOS_PIPER_SPEAKER_ID=

# LLM routing
KARIOS_LLM_ENABLED=true
KARIOS_LLM_MODEL=google/gemini-2.5-flash

# Logging
KARIOS_DEBUG=false
KARIOS_LOG_LEVEL=INFO

# Safety controls
KARIOS_ALLOW_POWER_ACTIONS=false
KARIOS_REQUIRE_POWER_CONFIRMATION=true
